{%- liquid
  assign section_id = 'product-carousel-' | append: section.id
  assign heading = section.settings.heading
  assign show_view_all = section.settings.show_view_all
  assign view_all_text = section.settings.view_all_text
  assign view_all_link = section.settings.view_all_link
  assign products_to_show = section.settings.products_to_show
  assign show_all_products = section.settings.show_all_products

  # Get products based on selection method
  if section.settings.product_selection == 'manual'
    assign products = section.settings.products
  elsif section.settings.product_selection == 'collection'
    assign collection = section.settings.collection
    if collection != blank
      assign products = collection.products
    endif
  elsif section.settings.product_selection == 'best_selling'
    # TODO: add best selling products logic - currently just showing all products
    assign all_collection = collections.all
    assign products = all_collection.products
  endif



-%}

<section id="{{ section_id }}" class="carousel-section">
  <!-- container -->
  <div class="container">
    <!-- header section: title, view more button (desktop) -->
    {% if heading != blank %}
      <h2>{{ heading }}</h2>
    {% endif %}
    {% if show_view_all %}
      <a href="{{ view_all_link }}">
        {{ view_all_text }}
      </a>
    {% endif %}
    <!-- Desktop/Mobile:product carousel layout -->
    {% if products != blank %}
      <div class="product-card">
        {% for product in products %}
          {{ product.url }}
          {{ product.featured_image | image_url: width: 400 }}
          {{ product.title }}
          {{ product.price }}
          {{ product.compare_at_price }}

          {{ products_to_show }}
          {{ show_all_products }}
          {{  }}
        {%  endfor %}
      </div>
    {%  endif %}
    <!-- Mobile: view more button -->
  </div>
</section>

{% schema %}
{
  "name": "Product Carousel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Carousel Title"
    },
    {
      "type": "select",
      "id": "product_selection",
      "label": "Product Selection Method",
      "options": [
        {
          "value": "manual",
          "label": "Manual Selection"
        },
        {
          "value": "collection",
          "label": "From Collection"
        },
        {
          "value": "best_selling",
          "label": "Best Selling Products"
        }
      ],
      "default": "best_selling"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Select Products",
      "info": "Choose specific products to display",
      "limit": 8
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Display products from this collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 4,
      "label": "Number of products to show"
    },
    {
      "type": "checkbox",
      "id": "show_all_products",
      "label": "Show all products (ignore limit)",
      "default": false,
      "info": "When enabled, displays all available products regardless of the limit above"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All button text",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All button link",
      "info": "Leave empty to link to all products"
    }
  ],
  "presets": [
    {
      "name": "Product Carousel",
      "category": "Products"
    }
  ]
}
{% endschema %}
